# ─── TIMEFLOW frontend environment ───────────────────────────────────────────
# Copy to .env.local. Nothing here is a secret: only NEXT_PUBLIC_* values reach the browser bundle.

# Where the Next.js SERVER forwards /api/* requests (server-side only, never exposed to the browser).
API_INTERNAL_URL=http://localhost:4000

# Optional. Leave unset so the browser calls the same-origin /api proxy.
# Set it only if you serve the API on a different origin (then the API's FRONTEND_ORIGIN/CORS must allow it).
NEXT_PUBLIC_API_URL=
