# ─── TIMEFLOW backend environment ────────────────────────────────────────────
# Copy to .env and adjust. Never commit a real .env file.

NODE_ENV=development
PORT=4000

# PostgreSQL (docker-compose exposes it on host port 5433)
DATABASE_URL=postgresql://timeflow:timeflow_dev_password@localhost:5433/timeflow?schema=public
# Used only by the integration test suite — must point at a disposable database.
TEST_DATABASE_URL=postgresql://timeflow:timeflow_dev_password@localhost:5433/timeflow_test?schema=public

# Redis (cache, BullMQ queues). Leave empty to run with the in-process fallback
# (jobs execute inline, cache is per-process) — fine for local dev and tests.
REDIS_URL=redis://localhost:6380

# Browser origin(s) allowed by CORS, comma separated.
FRONTEND_ORIGIN=http://localhost:3000

# 32+ random characters. Signs CSRF tokens. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_HOURS=168
# Must be true behind HTTPS (production). false only for http://localhost.
COOKIE_SECURE=false
# Lets the production build run over plain http://localhost (docker compose demo). NEVER enable on a real deployment.
ALLOW_INSECURE_COOKIES=false
# Optional parent domain when frontend and API live on sibling subdomains.
COOKIE_DOMAIN=

# AI Time Coach. Without a key the coach runs in a clearly labelled deterministic demo mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_MESSAGE_LIMIT=40
# Reasoning tokens count toward this cap, so do not set it low.
AI_MAX_OUTPUT_TOKENS=4096
# low | medium | high — how much the model thinks per answer (cost vs depth).
AI_EFFORT=medium

# Default requests per minute per client address (credential and AI endpoints are stricter).
RATE_LIMIT_PER_MINUTE=600

# Observability
LOG_LEVEL=info
# Set to an OTLP/HTTP collector base URL (e.g. http://localhost:4318) to enable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=timeflow-backend

# Serve Swagger UI at /api/docs (always on outside production).
SWAGGER_ENABLED=true
